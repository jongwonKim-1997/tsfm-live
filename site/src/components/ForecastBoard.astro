---
import {read,readOptional,href} from '../lib/data';
import en from '../i18n/en.json';
import ko from '../i18n/ko.json';
import {chooseDashboardData,dashboardBoardMarkup} from '../lib/dashboard-view.mjs';
const {locale}=Astro.props;
const words=locale==='ko'?ko:en;
const data=chooseDashboardData(readOptional('local_dashboard'),read('forecast_view'));
const markup=dashboardBoardMarkup(data,locale,words,{recordHref:href(locale,data.mode==='local_zero_shot'?'/ledger':'/today')});
---
<Fragment set:html={markup}/>
<script>
  import {initializeDashboard} from '../lib/dashboard-client.mjs';
  import en from '../i18n/en.json';
  import ko from '../i18n/ko.json';
  const locale=document.documentElement.lang;
  initializeDashboard(document.querySelector('[data-forecast-board]'),locale,locale==='ko'?ko:en);
</script>
