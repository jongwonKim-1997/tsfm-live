---
import {readOptional} from '../lib/data';
import {dailyMarkup} from '../lib/daily-view.mjs';
import '../styles/daily.css';
const {locale}=Astro.props;
const data=readOptional('daily_dashboard');
---
<section id="daily-board" class="daily-board" set:html={dailyMarkup(data,{locale})}/>
<script id="daily-initial" type="application/json" set:html={JSON.stringify(data).replace(/</g,'\\u003c')}/>
<script>
  import {initializeDaily} from '../lib/daily-client.mjs';
  const board=document.querySelector('#daily-board');
  if(board)initializeDaily(board,JSON.parse(document.querySelector('#daily-initial').textContent),document.documentElement.lang);
</script>
