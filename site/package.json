{
  "name": "tsfm-live-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/copy-lint.mjs && astro build && node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check:copy": "node scripts/copy-lint.mjs",
    "cards": "node scripts/cards.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@observablehq/plot": "0.6.17",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.6",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1"
  }
}
